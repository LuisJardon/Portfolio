---
// Project page, in English.
import ProyectoPagina from "../../../components/ProyectoPagina.astro";
import { conPagina } from "../../../data/contenido";

export function getStaticPaths() {
  return conPagina().map((proyecto) => ({ params: { slug: proyecto.slug }, props: { proyecto } }));
}
const { proyecto } = Astro.props;
---

<ProyectoPagina lang="en" proyecto={proyecto} />

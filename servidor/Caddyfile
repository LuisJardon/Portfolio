gestionbarber.rozadasnas.duckdns.org {
	encode zstd gzip
	reverse_proxy gb_frontend:80
}

n8n.rozadasnas.duckdns.org {
	reverse_proxy gb_n8n:5678
}

veoveo.rozadasnas.duckdns.org {

# Copia este archivo como .env y rellena lo que tengas activo. Si una línea queda vacía, esa función no se usa.

# Formulario de contacto: URL de un servicio de envío (opcional).
# Vacío = el formulario abre el programa de correo del visitante con el mensaje preparado.
PUBLIC_CONTACTO_ENDPOINT=

# Estadísticas de visitas con Umami (servidor/umami/). Sin ellas, no se carga ningún script.
PUBLIC_UMAMI_URL=
PUBLIC_UMAMI_ID=
